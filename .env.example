# Copy this file to .env.local (local dev) and add the same values in Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real keys. NEVER expose SUPABASE_SERVICE_ROLE_KEY or STRIPE_SECRET_KEY in the browser.

# --- Your site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domains allowed to call the API from a browser (your Framer site), comma-separated.
ALLOWED_ORIGINS=https://yourbrand.com,https://www.yourbrand.com

# Pro price in cents, used for MRR in sales stats. Keep in sync with Stripe.
PRO_PRICE_CENTS=2700
# File name of the playbook inside the private "playbook" storage bucket.
PLAYBOOK_FILE_PATH=deal-playbook.pdf

# --- Supabase (Dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Stripe (Dashboard -> Developers -> API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Dashboard -> Product catalog -> create product -> copy price ID)
STRIPE_PRICE_PLAYBOOK=price_...          # one-time, e.g. $47
STRIPE_PRICE_PRO_MONTHLY=price_...       # recurring monthly, e.g. $27/mo
STRIPE_PRICE_DEAL_REVIEW=price_...       # one-time $299 Deal Review
STRIPE_PRICE_WORKFLOW_AUDIT=price_...    # one-time $299 Workflow Audit (Growth Check)

# --- Make.com (optional) ---
# Create a scenario starting with "Custom webhook", paste its URL here.
# The backend sends it every new lead, purchase, subscription change, and premium request.
MAKE_WEBHOOK_URL=

# --- Booking link for premium clients (optional) ---
# Calendly event links. Deals: deal reviews, intro calls, plan kickoffs. Growth: workflow audits.
CALENDLY_DEALS_URL=https://calendly.com/your-handle/deal-review
CALENDLY_GROWTH_URL=https://calendly.com/your-handle/workflow-audit

# --- Owner email alerts (optional) ---
# New sales and done-for-you requests are emailed to OWNER_EMAIL via Resend (resend.com).
OWNER_EMAIL=you@example.com
RESEND_API_KEY=
# Optional custom sender once you verify a domain in Resend.
ALERT_FROM=
